{
  "name": "express-nodejs-course",
  "private": true,
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "prepare": "husky",
    "start": "npm run start -w server",
    "client": "npm run dev -w client",
    "server": "npm run dev -w server",
    "build": "npm run build -w client",
    "lint": "eslint . && npm run lint --prefix client",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "node.js"
  },
  "author": "Melnyk Anastasiia",
  "license": "ISC",
  "description": "Task 6",
  "keywords": [],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.70.1"
  }
}
